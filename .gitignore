# ─── AJOUT : caches de compilation par plateforme (absents jusqu'ici,
# risque réel de les committer par erreur — chacun fait plusieurs dizaines
# de Mo et se régénère automatiquement au premier build) ───────────────
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
ios/Pods/
ios/.symlinks/
macos/Pods/
macos/.symlinks/
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# Fichiers parasites générés accidentellement (crashs JVM Gradle sous Windows,
# artefacts de commandes shell mal interprétées)
hs_err_pid*.log
replay_pid*.log
