<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>DigitalPress</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>DigitalPress</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Nous avons besoin d'accéder à votre galerie pour changer votre photo de profil et ajouter des photos ou vidéos à vos publications.</string>
	<key>NSCameraUsageDescription</key>
	<string>Nous avons besoin d'accéder à votre caméra pour prendre une photo de profil.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Nous avons besoin d'accéder à votre microphone pour les vidéos.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- CORRIGÉ : NSAllowsArbitraryLoads=true désactivait App Transport
		     Security pour TOUT le trafic réseau, y compris en production
		     (HTTP non chiffré autorisé vers n'importe quel domaine). Apple
		     rejette les apps avec cette exception globale non justifiée.
		     On ne l'autorise plus que pour les hôtes de développement local
		     (émulateur/simulateur/LAN) ; toute autre destination (le vrai
		     backend en production) doit être en HTTPS. -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<!-- VPS de PRODUCTION : sert désormais le domaine
			     digitalpress-ml.com en HTTPS (Let's Encrypt). Les exceptions
			     HTTP clair vers 192.162.71.56 / vps123184 / domaines ont été
			     RETIRÉES : ATS exige le HTTPS pour toute la production.
			     En cas de retour temporaire au HTTP pour un test, corriger le
			     certificat côté VPS plutôt que de réintroduire une exception. -->
		</dict>
	</dict>
</dict>
</plist>
